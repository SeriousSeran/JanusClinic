{
  "name": "janus-clinic-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Janus React customer journey and preserved clinic website preview",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "extract": "python3 scripts/extract.py",
    "check": "python3 scripts/check.py",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "capture:portfolio": "node scripts/capture-portfolio.mjs",
    "docs:pdf": "node scripts/build-learning-guide.mjs",
    "preview:build": "node scripts/build-site.mjs --preview",
    "preview:serve": "python3 -m http.server 4173 --bind 127.0.0.1 --directory dist",
    "test:preview": "playwright test --config playwright.preview.config.mjs",
    "site:build": "node scripts/build-site.mjs",
    "skills:check": "python3 scripts/check-skills.py",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run preview:build",
    "test:compat": "playwright test --config playwright.compat.config.mjs",
    "handoff:zip": "python3 scripts/create-handoff.py"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "dependencies": {
    "glisse": "0.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
