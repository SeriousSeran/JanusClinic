{
  "name": "janus-clinic-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Faithful local extraction of the Janus Estheti Clinique public website",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "extract": "python3 scripts/extract.py",
    "check": "python3 scripts/check.py",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "capture:portfolio": "node scripts/capture-portfolio.mjs",
    "docs:pdf": "node scripts/build-learning-guide.mjs",
    "preview:build": "python3 scripts/build-preview.py",
    "preview:serve": "python3 -m http.server 4173 --bind 127.0.0.1 --directory dist",
    "test:preview": "playwright test --config playwright.preview.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
